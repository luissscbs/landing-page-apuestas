# ── CBS Sports Landing · Variables públicas de configuración ──
# Copiar a .env.local para desarrollo. Nunca commitear secretos.
NEXT_PUBLIC_CBS_APP_URL=https://app.cbssports.com
NEXT_PUBLIC_AFFILIATE_ID=cbs-landing-01
NEXT_PUBLIC_DEFAULT_CAMPAIGN=apertura

# ── Conexión con Backend de Cuotas y Predicciones ML (Fase API) ──
NEXT_PUBLIC_CBS_API_URL=http://localhost:8000/api/v1
CBS_API_KEY=server-only-no-exponer  # SOLO servidor, jamás NEXT_PUBLIC_

