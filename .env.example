# ── CBS Sports Landing · Variables públicas de configuración ──
# Copiar a .env.local para desarrollo. Nunca commitear secretos.
NEXT_PUBLIC_CBS_APP_URL=https://app.cbssports.com
NEXT_PUBLIC_AFFILIATE_ID=cbs-landing-01
NEXT_PUBLIC_DEFAULT_CAMPAIGN=apertura

# ── Conexión con Backend de Cuotas y Predicciones ML (Fase API) ──
NEXT_PUBLIC_CBS_API_URL=http://localhost:8000/api/v1
CBS_API_KEY=server-only-no-exponer  # SOLO servidor, jamás NEXT_PUBLIC_

# ── Pipeline datos / ETL (sports-data-pipeline) ──
# DATABASE_URL=postgres://user:pass@localhost:5432/cbs
# THE_ODDS_API_KEY=cambiar-en-local  # clave gratuita en https://the-odds-api.com (500 créd/mes)
# ODDS_TTL_S=21600  # refresco fuente viva: 6h (~480 créd/mes con 4 ligas)
# ODDS_LEAGUES=soccer_spain_la_liga,soccer_epl,soccer_italy_serie_a,soccer_germany_bundesliga
# ODDS_REGIONS=eu  # casas europeas, coste mínimo
# FOOTBALL_DATA_BASE=https://www.football-data.co.uk/mmz4281
# PIPELINE_DATA_DIR=data
